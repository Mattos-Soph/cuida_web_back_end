# ============================================================
# CUIDA — variáveis de PRODUÇÃO (copie para deploy/.env na VM)
# NUNCA faça commit do .env
# ============================================================

# --- Endereço público (DuckDNS, ex.: cuida-api.duckdns.org) ---
DOMINIO=

# --- Evolution API ---
# Chave da Evolution (invente uma longa). Gere com:
#   openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do Postgres interno da Evolution. Gere com:
#   openssl rand -hex 16
EVOLUTION_DB_PASSWORD=
WHATSAPP_INSTANCE=cuida

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Login (JWT) ---
JWT_SECRET=

# --- WhatsApp ---
# false = envia de verdade
WHATSAPP_MOCK=false
WHATSAPP_INTERVALO_MIN_MS=8000
WHATSAPP_INTERVALO_MAX_MS=20000
WHATSAPP_PAUSA_A_CADA=15
WHATSAPP_PAUSA_MIN_MS=60000
WHATSAPP_PAUSA_MAX_MS=180000
WHATSAPP_DIGITANDO_MIN_MS=1500
WHATSAPP_DIGITANDO_MAX_MS=4000
WHATSAPP_HORA_INICIO=8
WHATSAPP_HORA_FIM=20
WHATSAPP_VERIFICAR_NUMERO=true

# --- E-mail (opcional) ---
EMAIL_USER=
EMAIL_PASS=

# --- Proteção das rotas da gestão (header x-api-key). Recomendado em produção ---
NOTIFICACAO_API_KEY=
